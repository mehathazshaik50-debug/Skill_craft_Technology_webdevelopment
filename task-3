<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Quiz Game App</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body{
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg,#1e1e2f,#3a3a5f);
    color:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    margin:0;
}

.quiz-box{
    background:#2c2c54;
    padding:30px;
    border-radius:15px;
    width:350px;
    box-shadow:0 10px 25px rgba(0,0,0,0.5);
}

h2{
    margin-bottom:20px;
}

.option{
    display:block;
    background:#40407a;
    padding:10px;
    margin:8px 0;
    border-radius:8px;
    cursor:pointer;
    transition:0.3s;
}

.option:hover{
    background:#706fd3;
}

button{
    margin-top:15px;
    padding:10px;
    width:100%;
    border:none;
    border-radius:8px;
    background:#34ace0;
    color:#fff;
    font-size:16px;
    cursor:pointer;
}

button:hover{
    background:#227093;
}

.result{
    text-align:center;
}
</style>
</head>

<body>

<div class="quiz-box" id="quiz">
    <h2 id="question">Question</h2>
    <div id="options"></div>
    <button onclick="nextQuestion()">Next</button>
</div>

<script>

// Questions
const quizData = [
    {
        question: "What is HTML?",
        options: ["Programming Language", "Markup Language", "Database", "OS"],
        answer: 1
    },
    {
        question: "Which language is used for styling?",
        options: ["HTML", "Python", "CSS", "C++"],
        answer: 2
    },
    {
        question: "JavaScript is used for?",
        options: ["Design", "Logic", "Database", "Hosting"],
        answer: 1
    },
    {
        question: "Which is frontend?",
        options: ["Node.js", "React", "MongoDB", "Python"],
        answer: 1
    }
];

let currentQ = 0;
let score = 0;
let selected = null;

function loadQuestion(){
    let q = quizData[currentQ];
    document.getElementById("question").innerText = q.question;

    let optionsHTML = "";
    q.options.forEach((opt, index)=>{
        optionsHTML += `
        <div class="option" onclick="selectOption(${index})">${opt}</div>`;
    });

    document.getElementById("options").innerHTML = optionsHTML;
}

function selectOption(index){
    selected = index;
}

function nextQuestion(){
    if(selected === null){
        alert("Please select an answer!");
        return;
    }

    if(selected === quizData[currentQ].answer){
        score++;
    }

    selected = null;
    currentQ++;

    if(currentQ < quizData.length){
        loadQuestion();
    }else{
        showResult();
    }
}

function showResult(){
    document.getElementById("quiz").innerHTML = `
    <div class="result">
        <h2>Your Score</h2>
        <h1>${score} / ${quizData.length}</h1>
        <button onclick="location.reload()">Restart</button>
    </div>`;
}

// Start
loadQuestion();

</script>

</body>
</html>
